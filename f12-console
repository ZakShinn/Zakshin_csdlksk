    ) {

        console.warn(
            `⚠️ API báo ${totalElementsExpected} hồ sơ nhưng hiện lấy được ${allData.length}.`
        );

        console.warn(
            "Có thể dữ liệu trên server đã thay đổi trong lúc đang tải hoặc có trang request thất bại."
        );

    } else {

        console.log(
            "🎯 Số hồ sơ khớp với tổng total_elements của cả 2 nguồn."
        );
