    console.log(
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    );

    // ============================================================
    // 8. CHUYỂN SANG DỮ LIỆU EXCEL
    // ============================================================

    const excelData =
        isHealthDataPage
            ? allData.map(
                (item, index) => ({

                    "STT":
                        index + 1,

                    "ID":
                        item.id ?? "",

                    "Mã CSYT":
                        item.facility_code != null
                            ? String(
                                item.facility_code
                            )
                            : "",

                    "Loại GD":
                        item.txn_type ?? "",

                    "Họ và tên BN":
                        item.ten_bn ?? "",

                    "Trạng thái":
                        item.status ?? "",

                    "Thời gian":
                        formatDateTime(
                            item.created_at
                        ),

                    "Thông báo":
                        item.res_message ?? ""

                })
            )
            : allData.map(
                (item, index) => ({

                    "STT":
                        index + 1,

                    "Patient ID":
                        item.patient_id ?? "",

                    "Check Up ID":
                        item.check_up_id ?? "",

                    "Ngày khám":
                        formatDateTime(
                            item.ngay_kham
                        ),

                    "Trạng thái":
                        item.status ?? "",

                    "Loại":
                        item.type ?? "",

                    "Lần khám":
                        item.times ?? "",

                    "Họ và tên":
                        item.full_name ?? "",

                    // Luôn giữ CCCD dưới dạng chuỗi
                    "CCCD":
                        item.id_number != null
                            ? String(
                                item.id_number
                            )
                            : "",

                    "Ngày sinh":
                        formatDate(
                            item.date_of_birth
                        ),

                    "Giới tính":
                        item.gender === "male"
                            ? "Nam"
                            : item.gender === "female"
                            ? "Nữ"
                            : (
                                item.gender ?? ""
                            ),

                    "Địa chỉ":
                        item.detail_address ?? "",

                    "Nguồn":
                        item._nguon ?? ""

                })
            );

    // ============================================================
    // 9. TẠO SHEET
    // ============================================================

    const ws =
        XLSX.utils.json_to_sheet(
            excelData
        );

    // Chiều rộng các cột
    ws["!cols"] = isHealthDataPage
        ? [
            { wch: 8  },
            { wch: 38 },
            { wch: 18 },
            { wch: 14 },
            { wch: 28 },
            { wch: 12 },
            { wch: 20 },
            { wch: 40 }
        ]
        : [
            { wch: 8  }, // STT
            { wch: 15 }, // Patient ID
            { wch: 15 }, // Check Up ID
            { wch: 20 }, // Ngày khám
            { wch: 15 }, // Trạng thái
            { wch: 12 }, // Loại
            { wch: 10 }, // Lần khám
            { wch: 30 }, // Họ tên
            { wch: 20 }, // CCCD
            { wch: 15 }, // Ngày sinh
            { wch: 12 }, // Giới tính
            { wch: 50 }, // Địa chỉ
            { wch: 12 }  // Nguồn
        ];

    // ============================================================
    // 10. ÉP MÃ CSYT / CCCD THÀNH TEXT
    // ============================================================

    if (ws["!ref"]) {

        const range =
            XLSX.utils.decode_range(
                ws["!ref"]
            );

        // Health Data: Mã CSYT = cột 2 | Checkup: CCCD = cột 8
        const textCol =
            isHealthDataPage ? 2 : 8;

        for (
            let r = 1;
            r <= range.e.r;
            r++
        ) {

            const address =
                XLSX.utils.encode_cell({
                    r,
                    c: textCol
                });

            const cell =
                ws[address];

            if (cell) {
                cell.t = "s";
                cell.z = "@";
            }
        }
    }

    // ============================================================
    // 11. FREEZE / FILTER
    // ============================================================

    ws["!autofilter"] = {
        ref:
            ws["!ref"]
    };

    // ============================================================
    // 12. TẠO WORKBOOK
    // ============================================================

    const wb =
        XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
        wb,
        ws,
        isHealthDataPage
            ? "Lịch sử sync"
            : "Danh sách khám"
    );

    // ============================================================
    // 13. TÊN FILE
    // ============================================================

    const now =
        new Date();

    const yyyy =
        now.getFullYear();

    const mm =
        String(
            now.getMonth() + 1
        ).padStart(2, "0");

    const dd =
        String(
            now.getDate()
        ).padStart(2, "0");

    const hh =
        String(
            now.getHours()
        ).padStart(2, "0");

    const min =
        String(
            now.getMinutes()
        ).padStart(2, "0");

    const fileName =
        isHealthDataPage
            ? `csdlksk_health_data_${yyyy}-${mm}-${dd}_${hh}-${min}.xlsx`
            : `PhieuKhamCsdlksk_${yyyy}-${mm}-${dd}_${hh}-${min}.xlsx`;

    // ============================================================
    // 14. XUẤT FILE
    // ============================================================

    XLSX.writeFile(
        wb,
        fileName
    );

    console.log(
        "%c🎉 HOÀN TẤT",
        "font-size:18px;font-weight:bold;color:#4caf50"
    );

    console.log(
        `📁 File: ${fileName}`
    );

    console.log(
        `👥 Tổng bản ghi xuất: ${excelData.length}`
    );

    if (
        allFailedPages.length
    ) {

        console.warn(
            `⚠️ Chưa lấy được ${allFailedPages.length} trang:`,
            allFailedPages
        );

    } else {

        console.log(
            "✅ Đã xử lý toàn bộ các trang API."
        );
    }

})();
