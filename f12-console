    // ============================================================
    // 1. TÌM TOKEN TỰ ĐỘNG
    // ============================================================

    function decodeJwtPayload(token) {
        try {
            const parts = token.split(".");

            if (parts.length !== 3)
                return null;

            let payload = parts[1]
                .replace(/-/g, "+")
                .replace(/_/g, "/");

            while (payload.length % 4)
                payload += "=";

            return JSON.parse(
                decodeURIComponent(
                    atob(payload)
                        .split("")
                        .map(c =>
                            "%" +
                            ("00" + c.charCodeAt(0).toString(16))
                                .slice(-2)
                        )
                        .join("")
                )
            );

        } catch {
            return null;
        }
    }

    function isJwtExpired(token) {
        const payload = decodeJwtPayload(token);

        if (!payload?.exp)
            return false;

        return Date.now() >= payload.exp * 1000;
    }

    function searchTokenInValue(value, path = "") {
        if (
            value === null ||
            value === undefined
        ) {
            return null;
        }

        // -----------------------------------------
        // STRING
        // -----------------------------------------

        if (typeof value === "string") {

            const trimmed = value.trim();

            // Bearer TOKEN
            const bearerMatch =
                trimmed.match(
                    /Bearer\s+([A-Za-z0-9._~+/=-]+)/i
                );

            if (bearerMatch) {
                return {
                    token: bearerMatch[1],
                    path
                };
            }

            // JWT xxx.yyy.zzz
            const jwtMatch =
                trimmed.match(
                    /eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/
                );

            if (jwtMatch) {
                return {
                    token: jwtMatch[0],
                    path
                };
            }

            // Có thể storage chứa JSON dưới dạng chuỗi
            try {
                const parsed = JSON.parse(trimmed);

                return searchTokenInValue(
                    parsed,
                    path
                );

            } catch {
                return null;
            }
        }

        // -----------------------------------------
        // OBJECT
        // -----------------------------------------

        if (
            typeof value === "object"
        ) {
            const priorityKeys = [
                "access_token",
                "accessToken",
                "access-token",
                "token",
                "jwt",
                "id_token",
                "idToken",
                "authorization",
                "authToken",
                "bearerToken"
            ];

            // Ưu tiên key có tên giống token
            for (const wanted of priorityKeys) {

                for (
                    const [key, childValue]
                    of Object.entries(value)
                ) {

                    if (
                        key.toLowerCase() ===
                        wanted.toLowerCase()
                    ) {

                        const result =
                            searchTokenInValue(
                                childValue,
                                path
                                    ? `${path}.${key}`
                                    : key
                            );

                        if (result)
                            return result;
                    }
                }
            }

            // Sau đó quét toàn bộ object
            for (
                const [key, childValue]
                of Object.entries(value)
            ) {

                const result =
                    searchTokenInValue(
                        childValue,
                        path
                            ? `${path}.${key}`
                            : key
                    );

                if (result)
                    return result;
            }
        }

        return null;
    }

    function findToken() {

        const storageList = [
            {
                name: "localStorage",
                storage: localStorage
            },
            {
                name: "sessionStorage",
                storage: sessionStorage
            }
        ];

        const priorityKeyWords = [
            "access_token",
            "accesstoken",
            "token",
            "jwt",
            "auth",
            "login",
            "user",
            "account",
            "session"
        ];

        const candidates = [];

        // -----------------------------------------
        // Ưu tiên các storage key có vẻ liên quan
        // -----------------------------------------

        for (const item of storageList) {

            for (
                let i = 0;
                i < item.storage.length;
                i++
            ) {

                const key =
                    item.storage.key(i);

                if (!key)
                    continue;

                const lowerKey =
                    key.toLowerCase();

                const priority =
                    priorityKeyWords.some(
                        word =>
                            lowerKey.includes(word)
                    );

                if (!priority)
                    continue;

                const raw =
                    item.storage.getItem(key);

                const result =
                    searchTokenInValue(
                        raw,
                        `${item.name}.${key}`
                    );

                if (
                    result?.token &&
                    !isJwtExpired(result.token)
                ) {
                    candidates.push(result);
                }
            }
        }

        // -----------------------------------------
        // Nếu chưa tìm thấy, quét hết storage
        // -----------------------------------------

        if (!candidates.length) {

            for (const item of storageList) {

                for (
                    let i = 0;
                    i < item.storage.length;
                    i++
                ) {

                    const key =
                        item.storage.key(i);

                    if (!key)
                        continue;

                    const raw =
                        item.storage.getItem(key);

                    const result =
                        searchTokenInValue(
                            raw,
                            `${item.name}.${key}`
                        );

                    if (
                        result?.token &&
                        !isJwtExpired(result.token)
                    ) {
                        candidates.push(result);
                    }
                }
            }
        }

        if (!candidates.length)
            return null;

        // Ưu tiên JWT có payload hợp lệ
        const jwtCandidate =
            candidates.find(
                x =>
                    decodeJwtPayload(x.token)
            );

        return jwtCandidate || candidates[0];
    }

    const tokenResult = findToken();

    if (!tokenResult) {

        console.error(
            "❌ Không tìm thấy access token trong localStorage/sessionStorage."
        );

        console.log(
