                    rememberDroppedField(key);
                    continue;
                }

                cleaned[key] = value;
                continue;
            }

            cleaned[key] = value;
        }

        return cleaned;
    }

    function stripExcludedFieldsFromJsonText(text) {
        if (!text || typeof text !== "string") {
            return text;
        }

        let output = "";
        let i = 0;

        while (i < text.length) {
            const quote = text.indexOf('"', i);

            if (quote === -1) {
                output += text.slice(i);
                break;
            }

            let j = quote + 1;
            let escaped = false;

            while (j < text.length) {
                const ch = text[j];

                if (escaped) {
                    escaped = false;
                    j++;
                    continue;
                }

                if (ch === "\\") {
                    escaped = true;
                    j++;
                    continue;
                }

                if (ch === '"') {
                    break;
                }

                j++;
            }

            if (j >= text.length) {
                output += text.slice(i);
                break;
            }

            const token = text.slice(quote + 1, j);
            let k = j + 1;

            while (
                k < text.length &&
                /\s/.test(text[k])
            ) {
                k++;
            }

            if (text[k] !== ":") {
                output += text.slice(i, j + 1);
                i = j + 1;
                continue;
            }

            k++;

            while (
                k < text.length &&
                /\s/.test(text[k])
            ) {
                k++;
            }

            if (text[k] !== '"') {
                output += text.slice(i, j + 1);
                i = j + 1;
                continue;
            }

            let v = k + 1;
            let valueEscaped = false;
            let valueLength = 0;

            while (v < text.length) {
                const ch = text[v];

                if (valueEscaped) {
                    valueEscaped = false;
                    v++;
                    valueLength++;
                    continue;
                }

                if (ch === "\\") {
                    valueEscaped = true;
                    v++;
                    continue;
                }

                if (ch === '"') {
                    break;
                }

                v++;
                valueLength++;
            }

            const drop =
                isExcludedFieldName(token) ||
                valueLength > MAX_EXPORT_STRING;

            if (!drop || v >= text.length) {
                output += text.slice(i, j + 1);
                i = j + 1;
                continue;
            }

            rememberDroppedField(token);

            let removeStart = quote;
            let before = quote - 1;

            while (
                before >= i &&
                /\s/.test(text[before])
            ) {
                before--;
            }

            let removeEnd = v + 1;

            if (
                before >= i &&
                text[before] === ","
            ) {
                removeStart = before;
            } else {
                let after = removeEnd;

                while (
                    after < text.length &&
                    /\s/.test(text[after])
                ) {
                    after++;
                }

                if (text[after] === ",") {
                    removeEnd = after + 1;
                }
            }

            output += text.slice(i, removeStart);
            i = removeEnd;
        }

        return output;
    }

    function cleanExportText(value) {
        return String(value)
