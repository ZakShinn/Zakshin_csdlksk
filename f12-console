    async function fetchPage(
        page,
        apiUrl,
        retry = 0
    ) {

        const url =
            `${apiUrl}?page_number=${page}&page_size=${PAGE_SIZE}`;

        try {

            const response =
                await fetch(
                    url,
                    {
                        method: "GET",

                        // QUAN TRỌNG:
                        // Không gửi cookie để tránh:
                        // Access-Control-Allow-Origin: *
                        // + credentials include
                        credentials: "omit",

                        headers: {
                            "Accept":
                                "application/json",

                            "Authorization":
                                `Bearer ${TOKEN}`
                        }
                    }
                );

            if (!response.ok) {

                let errorBody = "";

                try {
                    errorBody =
                        await response.text();
                } catch {}

                throw new Error(
                    `HTTP ${response.status} ${response.statusText}` +
                    (
                        errorBody
                            ? ` | ${errorBody}`
                            : ""
                    )
                );
            }

            // Đọc text → cắt base64_ca trước khi parse
            // (tránh OOM khi trang có hồ sơ completed)
            const rawText =
                await response.text();

            const json =
                JSON.parse(
                    stripExcludedFieldsFromJsonText(
                        rawText
                    )
                );

            if (
                json?.header?.success === false
            ) {

                throw new Error(
                    `${json.header.res_code || ""} - ` +
                    `${json.header.res_msg || "API trả về lỗi"}`
                );
            }

            if (
                Array.isArray(
                    json?.data?.data
                )
            ) {
                json.data.data =
                    json.data.data.map(
                        sanitizeExaminationRow
                    );
            }

            return json;

        } catch (error) {

            if (
                retry < MAX_RETRY
            ) {

                console.warn(
                    `⚠️ Trang ${page} lỗi - thử lại ${retry + 1}/${MAX_RETRY}: ${error?.message || error}`
                );

                console.warn(
                    error.message
                );

                await sleep(
                    1000 * (retry + 1)
                );

                return fetchPage(
                    page,
                    apiUrl,
                    retry + 1
                );
            }

            throw error;
        }
    }

    function tagRowsWithSource(
        rows,
        sourceLabel
    ) {
        return rows.map(item => ({
            ...sanitizeExaminationRow(
                item
            ),
            _nguon: sourceLabel
        }));
    }

    async function fetchAllFromSource(
        source
    ) {
        console.log(
            `📥 [${source.label}] Đang lấy trang đầu tiên...`
        );

        const firstResponse =
            await fetchPage(
                1,
                source.url
            );

        const firstPage =
            firstResponse?.data;

        if (
            !firstPage ||
            !Array.isArray(
                firstPage.data
            )
        ) {
            throw new Error(
                `[${source.label}] Cấu trúc response không đúng`
            );
        }

        const totalPages =
            Number(
                firstPage.total_pages
            ) || 1;

        const totalElements =
            Number(
                firstPage.total_elements
            ) || 0;

        let rows =
            tagRowsWithSource(
                firstPage.data,
                source.label
            );

        console.log(
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        );

        console.log(
            `👥 [${source.label}] Tổng hồ sơ API báo: ${totalElements}`
        );

        console.log(
            `📄 [${source.label}] Tổng số trang: ${totalPages}`
        );

        console.log(
            `📦 [${source.label}] Trang 1: ${firstPage.data.length} hồ sơ`
        );

        console.log(
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        );

        const failedPages = [];

        for (
            let page = 2;
            page <= totalPages;
            page++
        ) {

            try {

                const json =
                    await fetchPage(
                        page,
                        source.url
                    );

                const data =
                    Array.isArray(
                        json?.data?.data
                    )
                        ? tagRowsWithSource(
                            json.data.data,
                            source.label
                        )
                        : [];

                rows.push(...data);

                const percent =
                    (
                        page /
                        totalPages *
                        100
                    ).toFixed(1);

                console.log(
                    `✅ [${source.label}] ${page}/${totalPages}` +
                    ` | ${percent}%` +
                    ` | +${data.length}` +
                    ` | Đã lấy: ${rows.length}`
                );

            } catch (error) {

                failedPages.push(page);

                console.error(
                    `❌ [${source.label}] Không lấy được trang ${page}:`,
                    error.message
                );
            }

            await sleep(
                REQUEST_DELAY
            );
        }

        if (failedPages.length) {

            console.warn(
                `⚠️ [${source.label}] Có ${failedPages.length} trang lỗi. Đang thử lại...`
            );

            for (
                const page of [
                    ...failedPages
                ]
            ) {

                try {

                    await sleep(1500);

                    const json =
                        await fetchPage(
                            page,
                            source.url
                        );

                    const data =
                        Array.isArray(
                            json?.data?.data
                        )
                            ? tagRowsWithSource(
                                json.data.data,
                                source.label
                            )
                            : [];

                    rows.push(...data);

                    const idx =
                        failedPages.indexOf(
                            page
                        );

                    if (idx !== -1) {
                        failedPages.splice(
                            idx,
                            1
                        );
                    }

                    console.log(
                        `✅ [${source.label}] Lấy lại trang ${page} thành công | +${data.length}`
                    );

                } catch (error) {

                    console.error(
                        `❌ [${source.label}] Trang ${page} vẫn lỗi:`,
                        error.message
                    );
                }
            }
        }

        return {
            label: source.label,
            rows,
            totalElements,
            totalPages,
            failedPages
        };
    }

    // ============================================================
    // 5. FORMAT NGÀY
    // ============================================================

    function formatDate(value) {

        if (!value)
            return "";

        const s =
            String(value);

        if (
            !/^\d{8}/.test(s)
        ) {
            return s;
        }

        const yyyy =
            s.slice(0, 4);

        const mm =
            s.slice(4, 6);

        const dd =
            s.slice(6, 8);

        return `${dd}/${mm}/${yyyy}`;
    }

    function formatDateTime(value) {

        if (!value)
            return "";

        const s =
            String(value);

        if (
            /^\d{12}/.test(s)
        ) {

            const yyyy =
                s.slice(0, 4);

            const mm =
                s.slice(4, 6);

            const dd =
                s.slice(6, 8);

            const hh =
                s.slice(8, 10);

            const min =
                s.slice(10, 12);

            return (
                `${dd}/${mm}/${yyyy} ` +
                `${hh}:${min}`
            );
        }

        // ISO: 2026-09-04T17:15:32.317196
        if (
            /^\d{4}-\d{2}-\d{2}T/.test(s)
        ) {
            const d = new Date(s);

            if (!Number.isNaN(d.getTime())) {
                const pad =
                    n =>
                        String(n).padStart(
                            2,
                            "0"
                        );

                return (
                    `${pad(d.getDate())}/` +
                    `${pad(d.getMonth() + 1)}/` +
                    `${d.getFullYear()} ` +
                    `${pad(d.getHours())}:` +
                    `${pad(d.getMinutes())}:` +
                    `${pad(d.getSeconds())}`
                );
            }
        }

        return formatDate(s);
    }

    // ============================================================
    // 6. LẤY DỮ LIỆU TỪ CẢ HAI NGUỒN
    // ============================================================

    let allData = [];
    let totalElementsExpected = 0;
    const allFailedPages = [];

    for (const source of API_SOURCES) {

        try {

            const result =
                await fetchAllFromSource(
                    source
                );

            allData.push(
                ...result.rows
            );

            totalElementsExpected +=
                result.totalElements;

            for (
                const page of result.failedPages
            ) {
                allFailedPages.push(
                    `${source.label} #${page}`
                );
            }

            console.log(
                `✅ [${source.label}] Hoàn tất: ${result.rows.length} hồ sơ`
            );

        } catch (error) {

            console.error(
                `❌ Không gọi được API [${source.label}].`
            );

            console.error(
                error
            );

            if (
                String(error).includes(
                    "401"
                )
            ) {
                console.error(
                    "🔐 Token không đúng hoặc đã hết hạn."
                );
            }

            return;
        }
    }

    // ============================================================
    // 7. LOẠI TRÙNG (trong cùng nguồn)
    // ============================================================

    const beforeDuplicate =
        allData.length;

    const uniqueMap =
        new Map();

    for (
        const item of allData
    ) {

        const baseKey =
            isHealthDataPage
                ? (
                    item.id ??
                    (
                        `${item.facility_code || ""}_` +
                        `${item.ten_bn || ""}_` +
                        `${item.created_at || ""}`
                    )
                )
                : (
                    item.check_up_id ??
                    (
                        `${item.patient_id || ""}_` +
                        `${item.ngay_kham || ""}_` +
                        `${item.id_number || ""}`
                    )
                );

        // Giữ cả hai nguồn nếu cùng hồ sơ xuất hiện ở cả hai API
        const key =
            `${item._nguon || ""}|${baseKey}`;

        uniqueMap.set(
            String(key),
            item
        );
    }

    allData =
        Array.from(
            uniqueMap.values()
        );

    console.log(
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    );

    console.log(
        `📦 Trước loại trùng: ${beforeDuplicate}`
    );

    console.log(
        `✅ Sau loại trùng: ${allData.length}`
    );

    console.log(
        `📊 API báo tổng (cả 2 nguồn): ${totalElementsExpected}`
    );

    if (
        allFailedPages.length
    ) {

        console.warn(
            "⚠️ Các trang chưa lấy được:",
