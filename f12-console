    async function fetchPage(
        page,
        apiUrl,
        retry = 0,
        queryParams = {},
        requestOpts = {}
    ) {

        const params =
            new URLSearchParams();

        params.set(
            "page_number",
            String(page)
        );

        params.set(
            "page_size",
            String(PAGE_SIZE)
        );

        for (const [key, value] of Object.entries(
            queryParams
        )) {
            if (
                value === null ||
                value === undefined ||
                value === ""
            ) {
                continue;
            }

            params.set(
                key,
                String(value)
            );
        }

        const url =
            `${apiUrl}?${params.toString()}`;

        const sameOrigin =
            typeof location !== "undefined" &&
            apiUrl.startsWith(
                location.origin
            );

        const useCredentials =
            requestOpts.usePageCredentials === true ||
            sameOrigin;

        // cookie = không Bearer (admin.csdlksk.vn)
        // bearer = gửi Authorization (api.emrhub.vn)
        const authMode =
            requestOpts.authMode ||
            (
                useCredentials && sameOrigin
                    ? "cookie"
                    : "bearer"
            );

        try {

            const headers = {
                "Accept":
                    "application/json"
            };

            if (authMode === "bearer") {
                headers.Authorization =
                    `Bearer ${TOKEN}`;
            }

            if (
                requestOpts.useContinuationToken &&
                requestOpts.continuationToken &&
                page > 1
            ) {
                headers["x-request-token"] =
                    requestOpts.continuationToken;
            }

            const response =
                await fetch(
                    url,
                    {
                        method: "GET",

                        credentials:
                            useCredentials
                                ? "include"
                                : "omit",

                        headers
                    }
                );

            if (!response.ok) {

                let errorBody = "";

                try {
                    errorBody =
                        await response.text();
                } catch {}

                if (response.status === 401) {
                    throw new Error(
                        "HTTP 401 — phiên đăng nhập hết hạn hoặc thiếu cookie. " +
                        "Hãy F5 / đăng nhập lại rồi chạy lại script."
                    );
                }

                throw new Error(
                    `HTTP ${response.status} ${response.statusText}` +
                    (
                        errorBody
                            ? ` | ${errorBody}`
                            : ""
                    )
                );
            }

            // Đọc text → cắt base64_ca trước khi parse
            // (tránh OOM khi trang có hồ sơ completed)
            const rawText =
                await response.text();

            const json =
                JSON.parse(
                    stripExcludedFieldsFromJsonText(
                        rawText
                    )
                );

            if (
                json?.header?.success === false
            ) {

                throw new Error(
                    `${json.header.res_code || ""} - ` +
                    `${json.header.res_msg || "API trả về lỗi"}`
                );
            }

            if (
                Array.isArray(
                    json?.data?.data
                )
            ) {
                json.data.data =
                    json.data.data.map(
                        sanitizeExaminationRow
                    );
            }

            const nextToken =
                response.headers.get(
                    "x-next-request-token"
                );

            if (nextToken) {
                json.__continuationToken =
                    nextToken;
            }

            return json;

        } catch (error) {

            if (
                retry < MAX_RETRY
            ) {

                console.warn(
                    `⚠️ Trang ${page} lỗi - thử lại ${retry + 1}/${MAX_RETRY}: ${error?.message || error}`
                );

                console.warn(
                    error.message
                );

                await sleep(
                    1000 * (retry + 1)
                );

                return fetchPage(
                    page,
                    apiUrl,
                    retry + 1,
                    queryParams,
                    requestOpts
                );
            }

            throw error;
        }
    }

    function tagRowsWithSource(
        rows,
        sourceLabel
    ) {
        return rows.map(item => ({
            ...sanitizeExaminationRow(
                item
            ),
            _nguon: sourceLabel
        }));
    }

    async function fetchAllFromSource(
        source
    ) {
        const queryParams =
            source.queryParams || {};

        const requestOpts = {
            usePageCredentials:
                source.usePageCredentials === true,
            authMode:
                source.authMode,
            useContinuationToken:
                source.useContinuationToken === true
        };

        const zeroBased =
            source.zeroBasedPages === true;

        const firstPageNum =
            zeroBased ? 0 : 1;

        console.log(
            `📥 [${source.label}] Đang lấy trang đầu tiên...`
        );

        const firstResponse =
            await fetchPage(
                firstPageNum,
                source.url,
                0,
                queryParams,
                requestOpts
            );

        const firstPage =
            firstResponse?.data;

        if (
            !firstPage ||
            !Array.isArray(
                firstPage.data
            )
        ) {
            throw new Error(
                `[${source.label}] Cấu trúc response không đúng`
            );
        }

        const totalPages =
            Number(
                firstPage.total_pages
            ) || 1;

        const totalElements =
            Number(
                firstPage.total_elements
            ) || 0;

        let rows =
            tagRowsWithSource(
                firstPage.data,
                source.label
            );

        console.log(
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        );

        console.log(
            `👥 [${source.label}] Tổng hồ sơ API báo: ${totalElements}`
        );

        console.log(
            `📄 [${source.label}] Tổng số trang: ${totalPages}` +
            (
                zeroBased
                    ? " (page 0-based)"
                    : ""
            )
        );

        console.log(
            `📦 [${source.label}] Trang ${firstPageNum}: ${firstPage.data.length} hồ sơ`
        );

        console.log(
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        );

        const failedPages = [];

        const lastPageNum =
            zeroBased
                ? totalPages - 1
                : totalPages;

        let continuationToken =
            firstResponse.__continuationToken ||
            null;

        for (
            let page = firstPageNum + 1;
            page <= lastPageNum;
            page++
        ) {

            try {

                const pageOpts = {
                    ...requestOpts,
                    continuationToken
                };

                const json =
                    await fetchPage(
                        page,
                        source.url,
                        0,
                        queryParams,
                        pageOpts
                    );

                const data =
                    Array.isArray(
                        json?.data?.data
                    )
                        ? tagRowsWithSource(
                            json.data.data,
                            source.label
                        )
                        : [];

                rows.push(...data);

                if (
                    json.__continuationToken
                ) {
                    continuationToken =
                        json.__continuationToken;
                }

                const doneCount =
                    zeroBased
                        ? page + 1
                        : page;

                const percent =
                    (
                        doneCount /
                        totalPages *
                        100
                    ).toFixed(1);

                console.log(
                    `✅ [${source.label}] ${doneCount}/${totalPages}` +
                    ` | ${percent}%` +
                    ` | +${data.length}` +
                    ` | Đã lấy: ${rows.length}`
                );

            } catch (error) {

                failedPages.push(page);

                console.error(
                    `❌ [${source.label}] Không lấy được trang ${page}:`,
                    error.message
                );
            }

            await sleep(
                REQUEST_DELAY
            );
        }

        if (failedPages.length) {

            console.warn(
                `⚠️ [${source.label}] Có ${failedPages.length} trang lỗi. Đang thử lại...`
            );

            for (
                const page of [
                    ...failedPages
                ]
            ) {

                try {

                    await sleep(1500);

                    const json =
                        await fetchPage(
                            page,
                            source.url,
                            0,
                            queryParams,
                            requestOpts
                        );

                    const data =
                        Array.isArray(
                            json?.data?.data
                        )
                            ? tagRowsWithSource(
                                json.data.data,
                                source.label
                            )
                            : [];

                    rows.push(...data);

                    const idx =
                        failedPages.indexOf(
                            page
                        );

                    if (idx !== -1) {
                        failedPages.splice(
                            idx,
                            1
                        );
                    }

                    console.log(
                        `✅ [${source.label}] Lấy lại trang ${page} thành công | +${data.length}`
                    );

                } catch (error) {

                    console.error(
                        `❌ [${source.label}] Trang ${page} vẫn lỗi:`,
                        error.message
                    );
                }
            }
        }

        return {
            label: source.label,
            rows,
            totalElements,
            totalPages,
            failedPages
        };
    }

    // ============================================================
    // 5. FORMAT NGÀY
    // ============================================================

    function formatDate(value) {

        if (!value)
            return "";

        const s =
            String(value);

        if (
            !/^\d{8}/.test(s)
        ) {
            return s;
        }

        const yyyy =
            s.slice(0, 4);

        const mm =
            s.slice(4, 6);

        const dd =
            s.slice(6, 8);

        return `${dd}/${mm}/${yyyy}`;
    }

    function formatDateTime(value) {

        if (!value)
            return "";

        const s =
            String(value);

        if (
            /^\d{12}/.test(s)
        ) {

            const yyyy =
                s.slice(0, 4);

            const mm =
                s.slice(4, 6);

            const dd =
                s.slice(6, 8);

            const hh =
                s.slice(8, 10);

            const min =
                s.slice(10, 12);

            return (
                `${dd}/${mm}/${yyyy} ` +
                `${hh}:${min}`
            );
        }

        // ISO: 2026-09-04T17:15:32.317196
        if (
            /^\d{4}-\d{2}-\d{2}T/.test(s)
        ) {
            const d = new Date(s);

            if (!Number.isNaN(d.getTime())) {
                const pad =
                    n =>
                        String(n).padStart(
                            2,
                            "0"
                        );

                return (
                    `${pad(d.getDate())}/` +
                    `${pad(d.getMonth() + 1)}/` +
                    `${d.getFullYear()} ` +
                    `${pad(d.getHours())}:` +
                    `${pad(d.getMinutes())}:` +
                    `${pad(d.getSeconds())}`
                );
            }
        }

        return formatDate(s);
    }

    // ============================================================
    // 6. LẤY DỮ LIỆU TỪ NGUỒN ĐÃ CHỌN
    // ============================================================

    let allData = [];
    let totalElementsExpected = 0;
    const allFailedPages = [];

    for (const source of API_SOURCES) {

        try {

            const result =
                await fetchAllFromSource(
                    source
                );

            allData.push(
                ...result.rows
            );

            totalElementsExpected +=
                result.totalElements;

            for (
                const page of result.failedPages
            ) {
                allFailedPages.push(
                    `${source.label} #${page}`
                );
            }

            console.log(
                `✅ [${source.label}] Hoàn tất: ${result.rows.length} hồ sơ`
            );

        } catch (error) {

            console.error(
                `❌ Không gọi được API [${source.label}].`
            );

            console.error(
                error
            );

            if (
                String(error).includes(
                    "401"
                )
            ) {
                console.error(
                    "🔐 Token không đúng hoặc đã hết hạn."
                );
            }

            return;
        }
    }

    // ============================================================
    // 7. LOẠI TRÙNG (trong cùng nguồn)
    // ============================================================

    const beforeDuplicate =
        allData.length;

    const uniqueMap =
        new Map();

    for (
        const item of allData
    ) {

        const baseKey =
            isHealthDataPage
                ? (
                    item.id ??
                    (
                        `${item.facility_code || ""}_` +
                        `${item.ten_bn || ""}_` +
                        `${item.created_at || ""}`
                    )
                )
                : (
                    item.check_up_id ??
                    (
                        `${item.patient_id || ""}_` +
                        `${item.ngay_kham || ""}_` +
                        `${item.id_number || ""}`
                    )
                );

        // Giữ cả hai nguồn nếu cùng hồ sơ xuất hiện ở cả hai API
        const key =
            `${item._nguon || ""}|${baseKey}`;

        uniqueMap.set(
            String(key),
            item
        );
    }

    allData =
        Array.from(
            uniqueMap.values()
        );

    console.log(
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    );

    console.log(
        `📦 Trước loại trùng: ${beforeDuplicate}`
    );

    console.log(
        `✅ Sau loại trùng: ${allData.length}`
    );

    console.log(
        `📊 API báo tổng: ${totalElementsExpected}`
    );

    if (
        allFailedPages.length
    ) {

        console.warn(
            "⚠️ Các trang chưa lấy được:",
            allFailedPages
        );
    }

    if (
        totalElementsExpected &&
        allData.length !==
            totalElementsExpected
    ) {

        console.warn(
            `⚠️ API báo ${totalElementsExpected} hồ sơ nhưng hiện lấy được ${allData.length}.`
        );

        console.warn(
            "Có thể dữ liệu trên server đã thay đổi trong lúc đang tải hoặc có trang request thất bại."
        );

    } else {

        console.log(
            "🎯 Số hồ sơ khớp với tổng total_elements."
        );
    }

    console.log(
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    );

    // ============================================================
    // 8. CHUYỂN SANG DỮ LIỆU EXCEL
    // ============================================================

    const sheet =
        rowsToExcelObjects(allData);

    const excelData =
        sheet.excelRows;

    // ============================================================
    // 9. TẠO SHEET
    // ============================================================

    const ws =
        XLSX.utils.json_to_sheet(
            excelData
        );

    prepareWorksheet(
        ws,
        sheet.fieldKeys,
        sheet.labels
    );

    // ============================================================
    // 10. TẠO WORKBOOK
    // ============================================================

    const wb =
        XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
        wb,
        ws,
        isHealthDataPage
            ? "Lịch sử sync"
            : "Danh sách khám"
    );

    // ============================================================
    // 13. TÊN FILE
    // ============================================================

    const now =
        new Date();

    const yyyy =
        now.getFullYear();

    const mm =
        String(
            now.getMonth() + 1
        ).padStart(2, "0");

    const dd =
        String(
            now.getDate()
        ).padStart(2, "0");

    const hh =
        String(
            now.getHours()
        ).padStart(2, "0");

    const min =
        String(
            now.getMinutes()
        ).padStart(2, "0");

    const fileName =
        isHealthDataPage
            ? `csdlksk_health_data_${yyyy}-${mm}-${dd}_${hh}-${min}.xlsx`
            : `PhieuKhamCsdlksk_${yyyy}-${mm}-${dd}_${hh}-${min}.xlsx`;

    // ============================================================
    // 14. XUẤT FILE
    // ============================================================

    XLSX.writeFile(
        wb,
        fileName
    );

    console.log(
        "%c🎉 HOÀN TẤT",
        "font-size:18px;font-weight:bold;color:#4caf50"
    );

    console.log(
        `📁 File: ${fileName}`
    );

    console.log(
        `👥 Tổng bản ghi xuất: ${excelData.length}`
    );

    if (
        allFailedPages.length
    ) {

        console.warn(
            `⚠️ Chưa lấy được ${allFailedPages.length} trang:`,
            allFailedPages
        );

    } else {

        console.log(
            "✅ Đã xử lý toàn bộ các trang API."
        );
    }

})();
